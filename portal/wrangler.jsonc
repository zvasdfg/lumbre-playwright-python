{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumbre-portal",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "ratelimits": [
    {
      "name": "ABUSE_RATE_LIMITER",
      "namespace_id": "1001001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumbre-db",
      "database_id": "cfe21e00-9638-4d62-9dc8-409debceb4b4",
      "migrations_dir": "drizzle"
    }
  ]
}
