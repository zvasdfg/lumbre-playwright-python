{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumbre-portal",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "ratelimits": [
    {
      "name": "ABUSE_RATE_LIMITER",
      "namespace_id": "1001001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumbre-db",
      "database_id": "cfe21e00-9638-4d62-9dc8-409debceb4b4",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    "production": {
      "name": "lumbre-portal",
      "vars": {
        "LUMBRE_ENV": "production",
        "NEXT_PUBLIC_LUMBRE_ENV": "production",
        "NEXT_PUBLIC_AUTH_ENABLED": "true",
        "AUTH_EMAIL_PROVIDER": "resend",
        "AUTH_EMAIL_FROM": "Lumbre <onboarding@resend.dev>",
        "BETTER_AUTH_URL": "https://lumbre-portal.lumbre-portal.workers.dev"
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "RESEND_API_KEY", "AUTH_ALLOWED_EMAIL"]
      },
      "images": {
        "binding": "IMAGES"
      },
      "ratelimits": [
        {
          "name": "ABUSE_RATE_LIMITER",
          "namespace_id": "1001001",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1001003",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ],
      "triggers": {
        "crons": ["0 4 * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lumbre-db",
          "database_id": "cfe21e00-9638-4d62-9dc8-409debceb4b4",
          "migrations_dir": "drizzle"
        }
      ]
    },
    "staging": {
      "name": "lumbre-portal-staging",
      "vars": {
        "LUMBRE_ENV": "production",
        "NEXT_PUBLIC_LUMBRE_ENV": "production",
        "NEXT_PUBLIC_AUTH_ENABLED": "true",
        "AUTH_EMAIL_PROVIDER": "resend",
        "AUTH_EMAIL_FROM": "Lumbre <onboarding@resend.dev>",
        "BETTER_AUTH_URL": "https://lumbre-portal-staging.lumbre-portal.workers.dev"
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "RESEND_API_KEY", "AUTH_ALLOWED_EMAIL"]
      },
      "images": {
        "binding": "IMAGES"
      },
      "ratelimits": [
        {
          "name": "ABUSE_RATE_LIMITER",
          "namespace_id": "1001002",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1001004",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ],
      "triggers": {
        "crons": ["0 4 * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lumbre-db-staging",
          "database_id": "835cfb3a-1fb5-4f4a-ae99-5343b71037a4",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
