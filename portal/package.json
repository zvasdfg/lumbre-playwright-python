{
  "name": "lumbre-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:next": "next dev",
    "dev:cloudflare": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply lumbre-db --local",
    "db:seed:local": "wrangler d1 execute lumbre-db --local --file=./db/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply lumbre-db --remote",
    "db:seed:remote": "wrangler d1 execute lumbre-db --remote --file=./db/seed.sql",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.59.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.12",
    "vite": "8.3.1",
    "webpack": "5.111.1",
    "wrangler": "4.138.0"
  },
  "type": "module"
}
